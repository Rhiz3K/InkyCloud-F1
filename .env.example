# Application Configuration
# Keep aggregate usage statistics, without individual visitor records.
# Explicit MINIMAL_DATA_MODE=true disables collection and erases all usage totals.
MINIMAL_DATA_MODE=false
AGGREGATE_STATS_ONLY=true
PERF_METRICS_SAMPLE_RATE=0.1
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
# Public base URL used for canonical tags, sitemap.xml, robots.txt, Open Graph, and www -> apex redirects
SITE_URL=https://racing.example.com

# Container Runtime Configuration
# Python bytecode and output buffering controls
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# Trusted reverse-proxy IPs/CIDRs for X-Forwarded-* headers (adjust for your platform if needed)
FORWARDED_ALLOW_IPS=127.0.0.1
# Port (can be overridden by container orchestration platforms like Coolify)
PORT=8000
# Advanced troubleshooting only: skip persistent-volume sanity check on startup
SKIP_PERSISTENCE_CHECK=false

# Sentry/GlitchTip (ignored while MINIMAL_DATA_MODE=true)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.0

# Optional server-only hourly usage summaries; no browser tracking script.
ANALYTICS_HOSTNAME=
GITHUB_API_BASE_URL=https://api.github.com
UMAMI_API_URL=https://analytics.example.com/api/send
UMAMI_ENABLED=false
UMAMI_WEBSITE_ID=

# API Configuration
# In the default aggregate and minimal profiles, limits are shared per process.
ADMIN_API_TOKEN=
DATA_API_RATE_LIMIT_PER_MINUTE=120
IMAGE_RATE_LIMIT_PER_MINUTE=120
JOLPICA_API_URL=https://api.jolpi.ca/ergast/f1/current/next.json
# Six tokens cover one teams cache miss (four primary plus two standings requests).
JOLPICA_BURST_CAPACITY=6
JOLPICA_MIN_REQUEST_INTERVAL=2.0
JOLPICA_MAX_RETRIES=6
PERF_METRICS_RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_ENABLED=true
REQUEST_TIMEOUT=10
STATS_RATE_LIMIT_PER_MINUTE=60

# Default Language
DEFAULT_LANG=en

# Default Timezone (IANA format)
DEFAULT_TIMEZONE=Europe/Prague

# Fixed display dimensions used by the renderer
DISPLAY_HEIGHT=480
DISPLAY_WIDTH=800

# Database and Storage Configuration
# Use absolute paths in containers (e.g., /app/data/f1.db for Docker)
# Use relative paths for local development (e.g., ./data/f1.db)
DATABASE_PATH=/app/data/f1.db
IMAGES_PATH=/app/data/images

# Scheduler Configuration
# Maximum wall-clock runtime for one historical refresh (90 minutes).
HISTORICAL_REFRESH_TIMEOUT_SECONDS=5400
SCHEDULER_ENABLED=true
# Usage totals: 400 days; performance histograms and batch receipts: 30 days.
# Zero is rejected. The compatibility legacy profile rolls up raw records after 30 days.
STATS_RETENTION_DAYS=400
RAW_STATS_RETENTION_DAYS=30

# Weather Configuration
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_MINUTES=60
WEATHER_ENABLED=true
# Total optional enrichment budgets; core calendars are published before these lookups.
WEATHER_ENRICHMENT_TIMEOUT_SECONDS=15
TEAMS_ENRICHMENT_TIMEOUT_SECONDS=30

# S3 Backup Configuration (ignored while MINIMAL_DATA_MODE=true)
# Cron expression for backup schedule (default: daily at 3 AM UTC)
BACKUP_CRON="0 3 * * *"
# Enable automatic backups to S3-compatible storage (Cloudflare R2, AWS S3, MinIO, etc.)
BACKUP_ENABLED=false
# Number of days to retain backups (1–400; zero is rejected)
BACKUP_RETENTION_DAYS=30

# S3 Connection Settings (required when BACKUP_ENABLED=true)
S3_ACCESS_KEY_ID=
S3_BUCKET_NAME=
# Example for Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# Region (use "auto" for Cloudflare R2)
S3_REGION=auto
S3_SECRET_ACCESS_KEY=

# Public deployment details. These values are deliberately blank; do not put private credentials here.
OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
HOSTING_DETAILS=Hetzner, Germany
HETZNER_DPA_CONFIRMED=false
MONITORING_DETAILS=
BACKUP_DETAILS=
