# Local Development Configuration
# Copy this file to .env for local development
#
# The default configuration in app/config.py uses absolute paths optimized for Docker (/app/data/*)
# For local development, use relative paths as shown below:

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SITE_URL=http://localhost:8000

# Local Runtime Configuration
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
SKIP_PERSISTENCE_CHECK=false
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Database and Storage Configuration (LOCAL DEVELOPMENT)
# Use relative paths for local development instead of absolute paths
DATABASE_PATH=./data/f1.db
IMAGES_PATH=./data/images

# Optional: Monitoring (leave empty for local dev)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: Analytics (disabled by default for local development)
UMAMI_WEBSITE_ID=
UMAMI_API_URL=https://analytics.example.com/api/send
UMAMI_ENABLED=false
ANALYTICS_HOSTNAME=localhost
GITHUB_API_BASE_URL=https://api.github.com

# API Configuration
JOLPICA_API_URL=https://api.jolpi.ca/ergast/f1/current/next.json
REQUEST_TIMEOUT=10
RATE_LIMIT_ENABLED=true
IMAGE_RATE_LIMIT_PER_MINUTE=120
PERF_METRICS_RATE_LIMIT_PER_MINUTE=240
DATA_API_RATE_LIMIT_PER_MINUTE=120
STATS_RATE_LIMIT_PER_MINUTE=60
ADMIN_API_TOKEN=

# Language & Timezone
DEFAULT_LANG=en
DEFAULT_TIMEZONE=Europe/Prague

# Fixed display dimensions used by the renderer
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480

# Scheduler Configuration
SCHEDULER_ENABLED=true
# Statistics retention in days. 0 (default) keeps all history forever;
# set e.g. 90 to opt into pruning and bound stats table/backup growth.
STATS_RETENTION_DAYS=90

# Weather Configuration
WEATHER_ENABLED=true
WEATHER_CACHE_MINUTES=60
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Backups (disabled by default for local development)
BACKUP_ENABLED=false
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
