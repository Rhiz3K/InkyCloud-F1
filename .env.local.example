# Local Development Configuration
# Copy this file to .env for local development
#
# The default configuration in app/config.py uses absolute paths optimized for Docker (/app/data/*)
# For local development, use relative paths as shown below:

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SITE_URL=http://localhost:8000

# Local Runtime Configuration
FORWARDED_ALLOW_IPS=127.0.0.1
PORT=8000
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
SKIP_PERSISTENCE_CHECK=false

# Database and Storage Configuration (LOCAL DEVELOPMENT)
# Use relative paths for local development instead of absolute paths
DATABASE_PATH=./data/f1.db
IMAGES_PATH=./data/images

# Optional: Monitoring (leave empty for local dev)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: Analytics (disabled by default for local development)
ANALYTICS_HOSTNAME=localhost
GITHUB_API_BASE_URL=https://api.github.com
UMAMI_API_URL=https://analytics.example.com/api/send
UMAMI_ENABLED=false
UMAMI_WEBSITE_ID=

# API Configuration
ADMIN_API_TOKEN=
DATA_API_RATE_LIMIT_PER_MINUTE=120
IMAGE_RATE_LIMIT_PER_MINUTE=120
JOLPICA_API_URL=https://api.jolpi.ca/ergast/f1/current/next.json
# Six tokens cover one teams cache miss (four primary plus two standings requests).
JOLPICA_BURST_CAPACITY=6
JOLPICA_MIN_REQUEST_INTERVAL=2.0
JOLPICA_MAX_RETRIES=6
PERF_METRICS_RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_ENABLED=true
REQUEST_TIMEOUT=10
STATS_RATE_LIMIT_PER_MINUTE=60

# Language & Timezone
DEFAULT_LANG=en
DEFAULT_TIMEZONE=Europe/Prague

# Fixed display dimensions used by the renderer
DISPLAY_HEIGHT=480
DISPLAY_WIDTH=800

# Scheduler Configuration
# Maximum wall-clock runtime for one historical refresh (90 minutes).
HISTORICAL_REFRESH_TIMEOUT_SECONDS=5400
SCHEDULER_ENABLED=true
# Statistics retention in days. Default 400 preserves the full 365-day dashboard
# while bounding stats table/backup growth. Set 0 to keep all history forever.
STATS_RETENTION_DAYS=400

# Weather Configuration
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_MINUTES=60
WEATHER_ENABLED=true

# Backups (disabled by default for local development)
BACKUP_CRON="0 3 * * *"
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=30
S3_ACCESS_KEY_ID=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_SECRET_ACCESS_KEY=
